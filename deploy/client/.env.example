# Copy this file to .env before the first start. Never commit .env.
DB_ROOT_PASSWORD=replace-with-a-unique-database-root-password
ERPNEXT_ADMIN_PASSWORD=replace-with-a-unique-erpnext-admin-password
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# First-run ERPNext company and initial inventory import settings.
COMPANY_NAME=Lightblenders
COMPANY_ABBR=LB
COMPANY_CURRENCY=NPR
COMPANY_COUNTRY=Nepal

# The Frappe site created on the first start. Do not change it after startup.
ERPNEXT_SITE_NAME=inventory.local

# Browser port on the client server. Use 80 only when it is available.
WEB_PORT=8088
